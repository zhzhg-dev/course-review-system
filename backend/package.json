{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for the course review system",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "local:windows": "node -e \"process.env.NODE_ENV='local'; require('./app.js')\"",
    "local:mac": "NODE_ENV=local node app.js",
    "production:windows": "node -e \"process.env.NODE_ENV='production'; require('./app.js')\"",
    "production:mac": "NODE_ENV=production node app.js",
    "seed:courses": "node seed/seedCourses.js",
    "reset:courses": "node seed/resetCourseData.js",
    "seed:discussion": "node seed/seedDiscussion.js",
    "seed:all": "node seed/seedAll.js",
    "seed:cloud": "node seed/seedAll.js --cloud",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}

